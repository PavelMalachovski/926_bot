# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Trade journal (/journal) ---
# OpenAI key for parsing MetaTrader history screenshots via Vision.
# Without it the bot still runs; screenshot parsing is disabled.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini          # must be a vision-capable model

# --- Forex data source ---
# Priority (SMC_FOREX_SOURCE=auto): Twelve Data key -> OANDA token. A forex
# key is REQUIRED — the keyless fallback feed was removed (its data was too
# coarse to trust). ETHUSD always uses Binance regardless.
SMC_FOREX_SOURCE=auto             # auto | twelvedata | oanda

# Twelve Data — free tier 800 req/day + 8 req/min, forex+crypto, works on
# Railway. Get a key at twelvedata.com (free signup). Recommended forex source.
# Requests are auto-throttled to stay under the per-minute cap; lower this only
# if your plan differs. Free tier comfortably covers 3 forex pairs.
# TWELVEDATA_API_KEY=
# TWELVEDATA_MAX_PER_MIN=8

# OANDA v20 (optional alternative): OANDA account -> Manage API Access.
# OANDA_API_TOKEN=
# OANDA_ENVIRONMENT=practice      # practice | live

# --- SMC Strategy Watcher ---
SMC_PAIRS=ETHUSD,USDJPY,USDCAD    # default pairs; change at runtime via /pairs.
# EURUSD/GBPUSD dropped from the default roster (sniper redesign, year
# replay): EURUSD loses under every tested rule, GBPUSD negative on the
# shipped conservative profile — see docs/superpowers/specs/
# 2026-08-12-sniper-redesign-design.md section 1. Still addable via /pairs.
SMC_SESSION_INTERVAL_MINUTES=5    # check cadence inside session windows
SMC_INTERVAL_MINUTES=15           # check cadence outside sessions
SMC_MIN_RR=1.0                    # RR to the nearest unswept liquidity below which an alert is warned (not skipped)
SMC_MAX_ENTRY_GAP_R=0.75          # warn once price has run this many R past the entry (0 = warn on any run past it)
SMC_TP1_R=2.0                     # hybrid exit: TP1 multiple of risk, taken on half the position
SMC_RUNNER_R=3.0                  # hybrid exit: runner TP multiple of risk, taken on the rest of the position
SMC_RISK_PCT=2.0
# SMC_DEPOSIT=1000                # deposit in USD for automatic lot hints
SMC_REQUIRE_IMBALANCE=false       # owner decision D22 (2026-08-30): the M5 imbalance no longer decides whether a setup exists — it supplies the best entry and gates the ⭐, and a CHoCH without one still alerts (entry falls back to the M5 order block, then to market). true restores the pre-D22 gate.
SMC_ENFORCE_SESSIONS=true
SMC_NOTIFY_NO_SETUP=false         # true = also send 15-min "no setup" heartbeats
SMC_TAKEN_COOLDOWN_HOURS=4        # after "Took it", mute that pair's alerts
SMC_MAX_SETUPS_PER_DAY=2          # owner decision D25 (2026-09-05): setup alerts SENT per pair per Prague day; a regular setup past the cap is journal-recorded and dedup-fingerprinted but not sent, a ⭐ always goes through. 0 = no cap
SMC_APPROACH_ALERT=true           # D25: the one get-ready message — price is within SMC_APPROACH_ZONE_FACTOR zone-heights of the H1 zone (or range boundary) Rule 2 waits at; carries the projected limit bracket (entry/SL/TP1-3). One per zone per day, never more per pair per day than SMC_MAX_SETUPS_PER_DAY
SMC_APPROACH_ZONE_FACTOR=1.0      # "almost there" = distance to the zone's near edge <= factor x zone height (floored at 2 x min FVG)
SMC_ZONE_PING=false               # legacy pre-D25 plan-zone alert (replaced by SMC_APPROACH_ALERT); true restores it
SMC_PD_ALERT=false                # legacy pre-D25 PD radar (replaced by SMC_APPROACH_ALERT; /pd still works on demand); true restores it
SMC_PLAN_CHANGE_ALERT=false       # legacy pre-D25 "🔁 Plan updated" message (the silent summary edit still happens); true restores it
SMC_PD_BASIS=h4                   # which dealing range premium/discount is measured on: h4 (H4 first, H1 fallback) | h1 (pre-audit H1-only reading)
# Automatic Pre-Market Plans: built silently just inside each session block; a
# muted summary with per-pair buttons arrives, the full plan only on press.
SMC_AUTO_PLAN=true
SMC_AUTO_PLAN_TIMES=08:05,14:05
SMC_CHART_CANDLES=384            # M5 candles on the alert chart (~32h)
# SMC_CHAT_ID=                    # override TELEGRAM_CHAT_ID for alerts

# --- Storage (SQLite: signals journal + runtime state) ---
# On Railway attach a volume and point this at it to survive redeploys.
SMC_DB_FILE=.smc_watcher.db
# SMC_DB_FILE=/data/smc.db

# --- Red-news filter (Forex Factory) ---
SMC_NEWS_ENABLED=true             # block entries around high-impact news
SMC_NEWS_DIGEST=true              # morning digest of today's red news
SMC_NEWS_DIGEST_TIME=07:55        # Prague local time (HH:MM) for the digest
SMC_NEWS_BLACKOUT_BEFORE_MIN=60   # no entries N minutes before a red release
SMC_NEWS_BLACKOUT_AFTER_MIN=15    # ...and N minutes after it

# --- Logging ---
LOG_LEVEL=INFO
